{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "ROTISERIA360 - Backend",
            "type": "pwa-node",
            "request": "launch",
            "program": "${workspaceFolder}/backend/server.js",
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "ROTISERIA360 - Frontend",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend-react",
            "sourceMaps": true
        }
    ],
    "compounds": [
        {
            "name": "ROTISERIA360 - FULL STACK",
            "configurations": [
                "ROTISERIA360 - Backend",
                "ROTISERIA360 - Frontend"
            ],
            "stopAll": true
        }
    ]
}
